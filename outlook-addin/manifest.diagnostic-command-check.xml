<?xml version="1.0" encoding="utf-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0" xsi:type="MailApp">
  <Id>8e511bf7-4d56-464e-a9e5-334653d7853b</Id>
  <Version>1.0.14.6</Version>
  <ProviderName>berliCRM</ProviderName>
  <DefaultLocale>de-DE</DefaultLocale>
  <DisplayName DefaultValue="berliCRM Befehlstest" />
  <Description DefaultValue="Outlook-Add-in für berliCRM mit Kontakt-, Termin- und E-Mail-Integration." />
  <IconUrl DefaultValue="https://unsercrm.i1.crm-now.de/outlook-addin/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://unsercrm.i1.crm-now.de/outlook-addin/assets/icon-80.png" />
  <SupportUrl DefaultValue="https://unsercrm.i1.crm-now.de/" />
  <AppDomains>
    <AppDomain>https://unsercrm.i1.crm-now.de</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.3" />
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://unsercrm.i1.crm-now.de/outlook-addin/diagnostic-taskpane.html?mode=read" />
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://unsercrm.i1.crm-now.de/outlook-addin/diagnostic-taskpane.html?mode=compose" />
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit" />
  </Rule>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox" />
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="commandsUrl" />
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="berliCrmReadGroup">
                <Label resid="groupLabel" />
                <Control xsi:type="Button" id="berliCrmReadButton">
                  <Label resid="readPaneButtonLabel" />
                  <Supertip>
                    <Title resid="readPaneButtonLabel" />
                    <Description resid="readPaneButtonDesc" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="icon16" />
                    <bt:Image size="32" resid="icon32" />
                    <bt:Image size="80" resid="icon80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="readTaskpaneUrl" />
                  </Action>
                </Control>
                <Control xsi:type="Button" id="berliCrmReadButtonCommandCheck">
                  <Label resid="commandCheckLabel" />
                  <Supertip>
                    <Title resid="commandCheckLabel" />
                    <Description resid="commandCheckDesc" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="icon16" />
                    <bt:Image size="32" resid="icon32" />
                    <bt:Image size="80" resid="icon80" />
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>diagnosticCommand</FunctionName>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
          <ExtensionPoint xsi:type="MessageComposeCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="berliCrmComposeGroup">
                <Label resid="groupLabel" />
                <Control xsi:type="Button" id="berliCrmComposeButton">
                  <Label resid="composePaneButtonLabel" />
                  <Supertip>
                    <Title resid="composePaneButtonLabel" />
                    <Description resid="composePaneButtonDesc" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="icon16" />
                    <bt:Image size="32" resid="icon32" />
                    <bt:Image size="80" resid="icon80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="composeTaskpaneUrl" />
                  </Action>
                </Control>
                <Control xsi:type="Button" id="berliCrmComposeButtonCommandCheck">
                  <Label resid="commandCheckLabel" />
                  <Supertip>
                    <Title resid="commandCheckLabel" />
                    <Description resid="commandCheckDesc" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="icon16" />
                    <bt:Image size="32" resid="icon32" />
                    <bt:Image size="80" resid="icon80" />
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>diagnosticCommand</FunctionName>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="icon16" DefaultValue="https://unsercrm.i1.crm-now.de/outlook-addin/assets/icon-32.png" />
        <bt:Image id="icon32" DefaultValue="https://unsercrm.i1.crm-now.de/outlook-addin/assets/icon-32.png" />
        <bt:Image id="icon80" DefaultValue="https://unsercrm.i1.crm-now.de/outlook-addin/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="commandsUrl" DefaultValue="https://unsercrm.i1.crm-now.de/outlook-addin/diagnostic-commands.html" />
        <bt:Url id="readTaskpaneUrl" DefaultValue="https://unsercrm.i1.crm-now.de/outlook-addin/diagnostic-taskpane.html?mode=read" />
        <bt:Url id="composeTaskpaneUrl" DefaultValue="https://unsercrm.i1.crm-now.de/outlook-addin/diagnostic-taskpane.html?mode=compose" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="commandCheckLabel" DefaultValue="Befehl testen" />
        <bt:String id="groupLabel" DefaultValue="berliCRM" />
        <bt:String id="readPaneButtonLabel" DefaultValue="berliCRM öffnen" />
        <bt:String id="composePaneButtonLabel" DefaultValue="berliCRM öffnen" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="commandCheckDesc" DefaultValue="Zeigt eine Testmeldung in Outlook an." />
        <bt:String id="readPaneButtonDesc" DefaultValue="berliCRM öffnen und zugehörige CRM-Daten anzeigen." />
        <bt:String id="composePaneButtonDesc" DefaultValue="berliCRM öffnen und E-Mails mit CRM-Verknüpfung senden." />
      </bt:LongStrings>
    </Resources>
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.5">
          <bt:Set Name="Mailbox" />
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <FunctionFile resid="commandsUrl" />
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="berliCrmReadGroup">
                  <Label resid="groupLabel" />
                  <Control xsi:type="Button" id="berliCrmReadButton">
                    <Label resid="readPaneButtonLabel" />
                    <Supertip>
                      <Title resid="readPaneButtonLabel" />
                      <Description resid="readPaneButtonDesc" />
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="icon16" />
                      <bt:Image size="32" resid="icon32" />
                      <bt:Image size="80" resid="icon80" />
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="readTaskpaneUrl" />
                      <SupportsPinning>false</SupportsPinning>
                    </Action>
                  </Control>
                  <Control xsi:type="Button" id="berliCrmReadButtonCommandCheck">
                    <Label resid="commandCheckLabel" />
                    <Supertip>
                      <Title resid="commandCheckLabel" />
                      <Description resid="commandCheckDesc" />
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="icon16" />
                      <bt:Image size="32" resid="icon32" />
                      <bt:Image size="80" resid="icon80" />
                    </Icon>
                    <Action xsi:type="ExecuteFunction">
                      <FunctionName>diagnosticCommand</FunctionName>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
            <ExtensionPoint xsi:type="MessageComposeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="berliCrmComposeGroup">
                  <Label resid="groupLabel" />
                  <Control xsi:type="Button" id="berliCrmComposeButton">
                    <Label resid="composePaneButtonLabel" />
                    <Supertip>
                      <Title resid="composePaneButtonLabel" />
                      <Description resid="composePaneButtonDesc" />
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="icon16" />
                      <bt:Image size="32" resid="icon32" />
                      <bt:Image size="80" resid="icon80" />
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="composeTaskpaneUrl" />
                      <SupportsPinning>false</SupportsPinning>
                    </Action>
                  </Control>
                  <Control xsi:type="Button" id="berliCrmComposeButtonCommandCheck">
                    <Label resid="commandCheckLabel" />
                    <Supertip>
                      <Title resid="commandCheckLabel" />
                      <Description resid="commandCheckDesc" />
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="icon16" />
                      <bt:Image size="32" resid="icon32" />
                      <bt:Image size="80" resid="icon80" />
                    </Icon>
                    <Action xsi:type="ExecuteFunction">
                      <FunctionName>diagnosticCommand</FunctionName>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="icon16" DefaultValue="https://unsercrm.i1.crm-now.de/outlook-addin/assets/icon-32.png" />
          <bt:Image id="icon32" DefaultValue="https://unsercrm.i1.crm-now.de/outlook-addin/assets/icon-32.png" />
          <bt:Image id="icon80" DefaultValue="https://unsercrm.i1.crm-now.de/outlook-addin/assets/icon-80.png" />
        </bt:Images>
        <bt:Urls>
          <bt:Url id="commandsUrl" DefaultValue="https://unsercrm.i1.crm-now.de/outlook-addin/diagnostic-commands.html" />
          <bt:Url id="readTaskpaneUrl" DefaultValue="https://unsercrm.i1.crm-now.de/outlook-addin/diagnostic-taskpane.html?mode=read" />
          <bt:Url id="composeTaskpaneUrl" DefaultValue="https://unsercrm.i1.crm-now.de/outlook-addin/diagnostic-taskpane.html?mode=compose" />
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="commandCheckLabel" DefaultValue="Befehl testen" />
          <bt:String id="groupLabel" DefaultValue="berliCRM" />
          <bt:String id="readPaneButtonLabel" DefaultValue="berliCRM öffnen" />
          <bt:String id="composePaneButtonLabel" DefaultValue="berliCRM öffnen" />
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="commandCheckDesc" DefaultValue="Zeigt eine Testmeldung in Outlook an." />
          <bt:String id="readPaneButtonDesc" DefaultValue="berliCRM öffnen und zugehörige CRM-Daten anzeigen." />
          <bt:String id="composePaneButtonDesc" DefaultValue="berliCRM öffnen und E-Mails mit CRM-Verknüpfung senden." />
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>